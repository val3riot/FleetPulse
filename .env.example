COMPOSE_PROJECT_NAME=fleetpulse

MAVEN_IMAGE=maven:3.9.13-eclipse-temurin-21-alpine
JAVA_RUNTIME_IMAGE=eclipse-temurin:21.0.11_10-jre-alpine-3.22

POSTGRES_VERSION=17.10-alpine3.23
POSTGRES_DB=fleetpulse
POSTGRES_USER=fleetpulse
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

FLYWAY_VERSION=13.0.0-alpine

REDIS_VERSION=8.2.8-alpine
REDIS_PASSWORD=change-me
REDIS_PORT=6379

KAFKA_VERSION=4.3.1
KAFKA_PORT=9092
KAFKA_TOPIC_RAW=telemetry.raw.v1
KAFKA_TOPIC_REJECTED=telemetry.rejected.v1
KAFKA_TOPIC_DEAD_LETTER=telemetry.dead-letter.v1
# Gateway response decision budget; producer values below are milliseconds (FP-056)
KAFKA_CONFIRMATION_TIMEOUT=5s
GATEWAY_KAFKA_MAX_BLOCK_MS=1000
GATEWAY_KAFKA_REQUEST_TIMEOUT_MS=1000
GATEWAY_KAFKA_DELIVERY_TIMEOUT_MS=4000
GATEWAY_KAFKA_LINGER_MS=0
KAFKA_TERMINAL_CONFIRMATION_TIMEOUT=5s
KAFKA_CONSUMER_GROUP_ID=fleetpulse-telemetry-processor-v1
KAFKA_CONSUMER_RETRY_MAX_ATTEMPTS=3
KAFKA_CONSUMER_RETRY_INITIAL_BACKOFF=500ms
KAFKA_CONSUMER_RETRY_MAX_BACKOFF=5s
KAFKA_CONSUMER_RETRY_MULTIPLIER=2.0
KAFKA_CONSUMER_RETRY_JITTER_RATIO=0.2

TELEMETRY_ALERT_MAXIMUM_ENGINE_TEMPERATURE_C=110.0
TELEMETRY_ALERT_MINIMUM_BATTERY_VOLTAGE=11.8

FLEET_API_PORT=8080
API_DASHBOARD_REPORTING_WINDOW=1m
API_DASHBOARD_RELEVANT_ALERTS_LIMIT=10
GATEWAY_TCP_PORT=7000
GATEWAY_HTTP_PORT=8081
PROCESSOR_HTTP_PORT=8082

SIMULATOR_ENABLED=false
SIMULATOR_VEHICLE_COUNT=5
SIMULATOR_SEND_INTERVAL=1s
SIMULATOR_GATEWAY_CONNECT_TIMEOUT=3s
SIMULATOR_SHUTDOWN_GRACE_PERIOD=5s
SIMULATOR_RECONNECT_INITIAL_BACKOFF=250ms
SIMULATOR_RECONNECT_MAX_BACKOFF=5s
SIMULATOR_RECONNECT_MAX_ATTEMPTS=10
SIMULATOR_RECONNECT_JITTER_RATIO=0.2
SIMULATOR_VEHICLE_SERVICE_INTERVAL_KM=15000
SIMULATOR_VEHICLE_INITIAL_ODOMETER_KM=10000

PROMETHEUS_VERSION=v3.7.3
PROMETHEUS_PORT=9090

GRAFANA_VERSION=12.3.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Histogram latency tuning (FP-041); these are observation ranges, not timeouts
METRICS_TIMER_MIN=1ms
METRICS_TIMER_MAX=30s
METRICS_TIMER_BUCKETS=50ms,100ms,250ms,500ms,1s,2s,5s,10s,30s

# Structured console logs (FP-040); set empty explicitly for local text output
FLEETPULSE_LOG_FORMAT=ecs

# Health/readiness (FP-048). Pool timeouts are milliseconds.
KAFKA_HEALTH_TIMEOUT=1s
DB_POOL_CONNECTION_TIMEOUT=1000
DB_POOL_VALIDATION_TIMEOUT=500
SPRING_DATA_REDIS_CONNECT_TIMEOUT=500ms
SPRING_DATA_REDIS_TIMEOUT=500ms
