{
  "name": "fleet-dashboard",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src --max-warnings=0",
    "verify": "npm run lint && npm run format:check && npm run check:contrast && npm run test:coverage && npm run test:fixtures && npm run test:tooling && npm run build && npm run check:production",
    "audit": "npm audit --audit-level=low",
    "mock:api": "node scripts/mock-api.mjs",
    "start:api-check": "ng serve --proxy-config proxy.api-check.json",
    "check:contrast": "node scripts/check-contrast.mjs",
    "mock:ui": "node scripts/ui-fixture/cli.mjs",
    "start:ui-check": "ng serve --port 4201 --proxy-config proxy.ui-check.json",
    "test:fixtures": "node --test scripts/ui-fixture/*.test.mjs",
    "test:coverage": "ng test --watch=false --coverage",
    "test:tooling": "node --test scripts/check-production.test.mjs",
    "check:production": "node scripts/check-production.mjs",
    "test:container": "node scripts/container/verify.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.1.0",
    "angular-eslint": "22.6.0",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=10"
  },
  "overrides": {
    "minimatch@>=7 <11": "11.0.5"
  }
}
